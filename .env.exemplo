# Copie para .env e preencha. Nunca publique o .env no GitHub.

# Endereço público do sistema (usado nos links dos e-mails)
SGI_URL_BASE=https://sgi.boxtech.com.br

# Texto aleatório longo que assina os links de aprovação. Gere com: openssl rand -hex 32
SGI_SEGREDO=

# Quem recebe os pedidos de cadastro e libera o acesso
SGI_APROVADOR=boxtech@boxtech.com.br

# Senha do administrador boxtech@boxtech.com.br. Use só no primeiro início e depois apague a linha.
ADMIN_SENHA=

# SMTP para enviar os e-mails (ex.: Microsoft 365: smtp.office365.com, porta 587)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=boxtech@boxtech.com.br
SMTP_SENHA=
SMTP_REMETENTE=SGI Boxtech <boxtech@boxtech.com.br>
